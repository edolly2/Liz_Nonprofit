STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Identification provider credentials - wire these into app/api/identify/route.ts.
PLANTNET_API_KEY=
INSECT_ID_API_KEY=

# Set true to keep the scanner in the built-in demonstration mode.
SCANNER_DEMO_MODE=true
